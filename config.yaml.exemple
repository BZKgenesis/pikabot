# --- Identifiants par défaut ---
# PROD
DEFAULT_PROD_GUILD_ID: &prod_guild_id 012345678910111213
DEFAULT_PROD_CHANNEL_ID: &prod_channel_id 131211109876543210
DEFAULT_PROD_CHANNEL_ID_SHORT: &prod_channel_id_short 131211111876543210

# --- PUBLIC ----

GUILD_ID: *prod_guild_id
GLOBAL_CHECK_INTERVAL: 120 # 2 minutes
SHORT_DURATION: 180        # 3 minutes
MAX_VIDEO_DELAY: 600       # 10 minutes
MIN_MESSAGE_DELAY: 50
ALLOWED_IDS: # admins
  - 123212321232123212
  - 456545654565456545
EMOJIS:
  - "🔥"
  - "👍"
  - "😎"
  - "🤣"
  - "❤️"
  - "🥳"
  - "😂"
MC_EMOJIS:
  - "exemple_emoji_id2"
  - "exemple_emoji_id1"
# --- Chaînes YouTube ---
channels:
  channel1:
    youtube_channel_id: "jkhJgJyfJHJHg565jb"
    # variable disponible : {video_title},{video_link},{description},{channel_title},{thumbnail_url}
    message: "Nouvelle vidéo en ligne :\n **{video_title}**\n 🎥 {video_link} \n ||@everyone||"
    message_short: ""
    discord_channel_id: *prod_channel_id
    discord_channel_id_short: *prod_channel_id_short

  channel2:
    youtube_channel_id: "UIdopokPy0636112"
    message: "Nouvelle vidéo en ligne sur la chaîne secondaire (enfin) :\n **{video_title}**\n 🎥 {video_link} \n ||@everyone||"
    message_short: ""
    discord_channel_id: *prod_channel_id
    discord_channel_id_short: 0 #short désactiver